# RescueLink API
PORT=3001
NODE_ENV=development
AWS_REGION=us-east-1
DYNAMODB_TABLE_INCIDENTS=rescue-incidents
USE_LOCAL_MOCK_STORE=false

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_MAX_TOKENS=300
BEDROCK_TEMPERATURE=0.2

# Step Functions Lambda workflow
STATE_MACHINE_ARN=
RESCUELINK_CALLBACK_URL=https://YOUR_PUBLIC_API_DOMAIN/api/workflows/triage
LAMBDA_CALLBACK_SECRET=replace-with-a-long-random-secret

# SNS / SES
SNS_TOPIC_ARN=
SES_FROM_EMAIL=alerts@example.com
SES_ALERT_RECIPIENT=responders@example.com

# Local triage fallback
TRIAGE_CRITICAL_PEOPLE_THRESHOLD=5
TRIAGE_HIGH_PEOPLE_THRESHOLD=3
TRIAGE_CRITICAL_NEEDS=medical,boat
TRIAGE_CRITICAL_CATEGORIES=fire
TRIAGE_HIGH_NEEDS=clean_water,food
TRIAGE_HIGH_CATEGORIES=landslide
TRIAGE_HEURISTIC_CONFIDENCE=0.92

# Satellite / LoRa gateway uplink
SATELLITE_API_KEY=replace-with-a-long-random-satellite-key
SATELLITE_IOT_TOPIC=rescuelink/satellite/+/uplink
SATELLITE_GATEWAY_URL=
SATELLITE_GATEWAY_SECRET=
