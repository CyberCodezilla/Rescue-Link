# ==============================================================================
# RescueLink Master Monorepo Environment Configuration Reference
# ==============================================================================
# Centralized Zod Schema: packages/config/src/index.ts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Express API Server Configuration (apps/api)
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. AWS Core & Storage Credentials (apps/api)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_INCIDENTS=rescue-incidents
USE_LOCAL_MOCK_STORE=false

# ------------------------------------------------------------------------------
# 3. AWS Bedrock AI Triage Configuration (apps/api)
# ------------------------------------------------------------------------------
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MAX_TOKENS=300
BEDROCK_TEMPERATURE=0.2
BEDROCK_TIMEOUT_MS=3500

# ------------------------------------------------------------------------------
# 4. Amazon SNS & SES Emergency Notifications (apps/api)
# ------------------------------------------------------------------------------
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:rescue-link-critical-alerts
SES_FROM_EMAIL=alerts@rescuelink.org
SES_ALERT_RECIPIENT=responders@rescuelink.org
NOTIFICATION_PRIORITY_GATE=critical,high

# ------------------------------------------------------------------------------
# 5. Security & Authentication Keys (apps/api & web apps)
# ------------------------------------------------------------------------------
API_KEY=rescuelink-responder-key-2026
NEXT_PUBLIC_API_KEY=rescuelink-responder-key-2026
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_SOS=20

# ------------------------------------------------------------------------------
# 6. Web Applications Gateway & Proxying (apps/survivor-web & apps/responder-web)
# ------------------------------------------------------------------------------
RESCUE_LINK_API_ORIGIN=http://localhost:3001
NEXT_PUBLIC_RESCUE_LINK_API_ORIGIN=http://localhost:3001
